{% extends "microsys/base.html" %}

{% block content %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">{{ record.name }}</h1>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary rounded-pill" href="{% url '{{ app_name }}:example_record_list' %}">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
            <a class="btn btn-primary rounded-pill" href="{% url '{{ app_name }}:example_record_edit' record.pk %}">
                <i class="bi bi-pencil"></i> Edit
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">{{ record.name }}</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">{{ record.description|default:"-" }}</dd>

                <dt class="col-sm-3">Active</dt>
                <dd class="col-sm-9">
                    {% if record.is_active %}
                        <span class="badge bg-success">Yes</span>
                    {% else %}
                        <span class="badge bg-secondary">No</span>
                    {% endif %}
                </dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">{{ record.created_at }}</dd>

                <dt class="col-sm-3">Updated At</dt>
                <dd class="col-sm-9">{{ record.updated_at }}</dd>
            </dl>
        </div>
    </div>
</div>
{% endblock %}
