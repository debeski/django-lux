{% extends "microsys/list_base.html" %}
{% load crispy_forms_tags %}
{% load render_table from django_tables2 %}

{% block content %}
<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">{{ app_title }}</h1>
            <p class="text-muted mb-0">MicroSys starter list page for {{ app_name }}.</p>
        </div>
        <a class="btn btn-primary rounded-pill" href="{% url '{{ app_name }}:example_record_add' %}">
            Add Record
        </a>
    </div>

    {% if filter %}
        {{ filter.form|crispy }}
    {% endif %}

    {% render_table table %}
</div>
{% endblock %}
