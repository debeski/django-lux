{% extends "dlux/list_base.html" %}
{% load crispy_forms_tags %}
{% load render_table from django_tables2 %}

{% block content %}
<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">{{ DLUX_STRINGS.app_{{ app_name }}|default:"{{ app_title }}" }}</h1>
            <p class="text-muted mb-0">{{ DLUX_STRINGS.{{ record_model_lower }}_list_intro|default:"DjangoLux starter list page." }}</p>
        </div>
        <button
            type="button"
            class="btn btn-primary rounded-pill"
            data-dynamic-modal="{% url 'modal_manager' '{{ app_name }}' '{{ record_model }}' 'new' %}"
            data-modal-title="{{ DLUX_STRINGS.{{ record_model_lower }}_add|default:"Add Record" }}"
        >
            {{ DLUX_STRINGS.{{ record_model_lower }}_add|default:"Add Record" }}
        </button>
    </div>

    {% if filter %}
        {{ filter.form|crispy }}
    {% endif %}

    {% render_table table %}
</div>
{% endblock %}
