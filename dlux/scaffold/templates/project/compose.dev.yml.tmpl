# Development override for compose.yml
# Usage: docker compose -f compose.yml -f compose.dev.yml up

name: {{ project_slug }}

services:
  smtp-relay:
    build: .
    image: !reset null

  caddy:
    ports: !override
      - target: 80
        published: "90"
        protocol: tcp

  web:
    build: .
    image: !reset null
    volumes: !override
      - ./:/app:rw
      - static:/app/staticfiles:rw
      - ./media/:/app/media/:rw
      - ./logs/:/app/logs:rw
      - ./imports/:/app/imports:ro
      - dlux_runtime:/opt/dlux-runtime:ro
    environment:
      BASE_URL: "http://localhost:90"
      DEBUG_STATUS: "True"
      CADDY_PORT: "90"
      # Off in development. Dev runs the bind-mounted source above, not an
      # installed release, so an inline update would stage a downloaded wheel
      # and repoint the runtime at it — meaningless against a working tree, and
      # one mis-click applies a real update to your dev container. It also stops
      # every dev box making a scheduled PyPI check. Turn it back on explicitly
      # if you are working on the updater itself.
      DLUX_INLINE_UPDATES_ENABLED: "False"

  celery:
    build: .
    image: !reset null
    volumes: !override
      - ./:/app:rw
      - static:/app/staticfiles:rw
      - ./media/:/app/media/:rw
      - ./logs/:/app/logs:rw
      - dlux_runtime:/opt/dlux-runtime:rw
    environment:
      # celery hosts the update worker, so it needs the same switch as web —
      # the shared anchor in compose.yml sets it for both.
      DLUX_INLINE_UPDATES_ENABLED: "False"

