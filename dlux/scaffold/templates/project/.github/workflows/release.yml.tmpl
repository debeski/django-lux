name: Release

# Triggered by pushing a version tag, e.g.:
#   git tag -a v0.1.0 -m "v0.1.0" && git push origin v0.1.0
#
# Pipeline:
#   build-push     -> verify tag == release-manifest.json version, resolve the
#                     pinned DjangoLux version, build amd64, push
#                     {{ project_image }}:<ver> + :{{ project_image_tag }}
#   github-release -> create the GitHub Release from the matching CHANGELOG section
#
# Before the first release, update release-manifest.json (version, summary,
# highlights, release_url) and add a matching `## vX.Y.Z` CHANGELOG section.
#
# One-time setup: add repository secrets
#   DOCKERHUB_USERNAME  - Docker Hub account/namespace
#   DOCKERHUB_TOKEN     - Docker Hub access token with read/write to {{ project_image }}

on:
  push:
    tags: ["v*"]

env:
  IMAGE: {{ project_image }}

permissions:
  contents: read

jobs:
  build-push:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Verify tag, resolve pinned DjangoLux, build manifest label
        id: project_manifest
        run: |
          python3 tools/validate_project_release_manifest.py

      - uses: docker/setup-buildx-action@v3

      - name: Log in to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Build and push (amd64)
        uses: docker/build-push-action@v6
        with:
          context: .
          platforms: linux/amd64
          push: true
          build-args: |
            DLUX_BAKED_VERSION=${{ steps.project_manifest.outputs.dlux_version }}
            DLUX_PROJECT_RELEASE_MANIFEST=${{ steps.project_manifest.outputs.label }}
          tags: |
            ${{ env.IMAGE }}:${{ github.ref_name }}
            ${{ env.IMAGE }}:{{ project_image_tag }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  github-release:
    needs: build-push
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4

      - name: Extract this version's CHANGELOG section
        run: |
          ver="${GITHUB_REF_NAME#v}"
          awk -v ver="$ver" '
            $0 ~ ("^## v" ver "([^0-9.]|$)") { grab=1; next }
            grab && /^## v/ { exit }
            grab { print }
          ' CHANGELOG.md > RELEASE_NOTES.md
          if [ ! -s RELEASE_NOTES.md ]; then
            echo "Release ${GITHUB_REF_NAME}." > RELEASE_NOTES.md
          fi
          echo "---- release notes ----"; cat RELEASE_NOTES.md

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          name: ${{ github.ref_name }}
          body_path: RELEASE_NOTES.md
