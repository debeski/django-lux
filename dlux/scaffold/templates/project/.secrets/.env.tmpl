# dlux stack schema {{ stack_schema }}
DJANGO_SECRET_KEY={{ secret_key }}
WEB_IMAGE={{ project_image }}:{{ project_image_tag }}
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin_pass
ADMIN_PASS=admin
BASE_URL=http://localhost
ALLOWED_URLS=http://localhost,http://localhost:90
ALLOWED_HOSTS=localhost,127.0.0.1,web,nginx,caddy,worker
TIME_ZONE=UTC
NGINX_PORT=80
NGINX_SERVER_NAME=localhost
NGINX_MAX_SIZE=10M
CADDY_PORT=80
CADDY_SITE_ADDRESS=:80
CADDY_MAX_SIZE=10MB
# Front proxy address(es) Caddy trusts for X-Forwarded-For, space-separated, no quotes.
# Unset: every private address. Empty: none (users reach this server directly).
# DLUX_FRONT_PROXY=10.0.0.5
DEFAULT_FROM_EMAIL=
SMTP_RELAY_HOST=smtp.gmail.com
SMTP_RELAY_PORT=587
SMTP_RELAY_USE_TLS=True
# Empty: SSL on port 465, STARTTLS otherwise. True/False to force it.
SMTP_RELAY_USE_SSL=
SMTP_RELAY_USER=
SMTP_RELAY_PASSWORD=
# The relay verifies the provider's certificate. A private CA: SMTP_RELAY_CA_FILE is its
# bundle's path inside smtp-relay (see compose.yml). False accepts any certificate.
SMTP_RELAY_TLS_VERIFY=True
SMTP_RELAY_CA_FILE=