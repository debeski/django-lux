# dlux stack schema {{ stack_schema }}

# ----------------------------
# Compression Settings (gzip)
# ----------------------------
gzip on;
gzip_disable "msie6";
gzip_vary on;
gzip_proxied any;
gzip_comp_level 7;
gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

# Preserve the scheme reported by a front proxy / TLS terminator (pfSense/
# HAProxy, another nginx, a cloud LB, ...): pass an incoming X-Forwarded-Proto
# through, fall back to this server's own scheme for direct clients. Without
# this, `$scheme` on the plain-HTTP listener stomps the terminator's `https`
# and Django never detects secure requests. X-Forwarded-For needs no such
# handling: `$proxy_add_x_forwarded_for` below already appends the peer to the
# incoming chain, which dlux's default `trusted_proxy_hops = 1` resolves to the
# real client IP — the front proxy must append it (HAProxy `option forwardfor`).
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# Fetch Metadata resource isolation (web.dev/articles/fetch-metadata), the nginx
# form of the Caddyfile's @cross_site_request: 1 for a request another site
# makes in the background (images, scripts, fetch(), form posts,
# <object>/<embed>), 0 for a link from another site (a top-level GET
# navigation), for same-origin, same-site and typed-in requests, and for
# requests without the header (crawlers, health checks, ScanLink,
# server-to-server calls, older browsers). The locations that reach the app
# (/media/ through the access check, /, /health) refuse it with 403; static
# files, public media, the update progress files, the maintenance page assets
# and the edge probe stay open to other sites. Composer's fetch-metadata check
# looks for $cross_site_request by name: keep it.
map "$http_sec_fetch_site:$request_method:$http_sec_fetch_mode:$http_sec_fetch_dest" $cross_site_request {
    default                                             0;
    "~^cross-site:(GET|HEAD):navigate:(object|embed)$"  1;
    "~^cross-site:(GET|HEAD):navigate:"                 0;
    "~^cross-site:"                                     1;
}

# How every stored file under /media/ is served, public or private, the nginx
# form of the Caddyfile's dlux_media_headers snippet: the browser never sniffs
# a type (nosniff), and a file it would run as a page (HTML, SVG, XML,
# JavaScript, anything not listed below) opens as a download in a sandbox with
# no script and no requests (Content-Security-Policy), so an upload cannot act
# on this site with the rights of whoever opens it. Raster images and PDF stay
# inline for previews and the PDF viewer; a PDF has no sandbox, which would
# stop the browser's PDF viewer. An empty value sends no header. Composer's
# stored-files check looks for these maps by name: keep them.
map $uri $dlux_media_csp {
    default     "default-src 'none'; sandbox";
    "~*\.pdf$"  "";
}

map $uri $dlux_media_disposition {
    default                                         "attachment";
    "~*\.(?:avif|bmp|gif|ico|jpe?g|pdf|png|webp)$"  "";
}

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};
    client_max_body_size ${NGINX_MAX_SIZE};
    error_page 502 503 504 =503 /dlux-maintenance.html;

    # Re-resolve the app container's IP at request time via Docker's embedded
    # DNS (127.0.0.11). A literal `proxy_pass http://web:8000` resolves once at
    # worker startup and caches that IP; when the composer updater recreates
    # `web` during an image update it comes back on a NEW IP, so nginx keeps
    # hammering the dead address and the app never returns until nginx itself is
    # restarted. Resolving through a variable + resolver makes nginx pick up the
    # new IP on its own (Caddy, the default proxy in this scaffold, does this
    # natively — this directive is the nginx-fallback equivalent).
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    set $web_upstream "web:8000";

    location = /dlux-maintenance.html {
        alias /opt/dlux-runtime/proxy/maintenance/index.html;
        internal;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'" always;
    }

    location ^~ /_dlux/maintenance/ {
        alias /opt/dlux-runtime/proxy/maintenance/;
        add_header Cache-Control "no-store";
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'";
    }

    location = /_update/status.json {
        alias /opt/dlux-runtime/state/deploy-status.json;
        default_type application/json;
        add_header Cache-Control "no-store";
        add_header X-Robots-Tag "noindex";
    }

    location = /_update/log.txt {
        alias /opt/dlux-runtime/state/deploy-log.txt;
        default_type text/plain;
        add_header Cache-Control "no-store";
        add_header X-Robots-Tag "noindex";
    }

    # Edge-liveness probe for a front proxy's health check. ALWAYS 200, served
    # entirely by nginx — never proxied to web, never gated by the maintenance
    # flag — so the front proxy keeps this backend marked UP while web is
    # recreated during an image update.
    location = /_edge-alive {
        return 200 "ok\n";
        default_type text/plain;
        access_log off;
    }

    location /static/ {
        alias /app/staticfiles/;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ^~ /media/dlux_backups/ {
        return 404;
    }

    # Public media (branding, managed images and fonts, the project's public/
    # folder). Keep in step with dlux.files.media.PUBLIC_MEDIA.
    location ^~ /media/public/ {
        root /app;
        add_header X-Content-Type-Options "nosniff";
        add_header Content-Security-Policy $dlux_media_csp;
        add_header Content-Disposition $dlux_media_disposition;
    }
    location ^~ /media/dlux/branding/ {
        root /app;
        add_header X-Content-Type-Options "nosniff";
        add_header Content-Security-Policy $dlux_media_csp;
        add_header Content-Disposition $dlux_media_disposition;
    }
    location ^~ /media/dlux/assets/image/ {
        root /app;
        add_header X-Content-Type-Options "nosniff";
        add_header Content-Security-Policy $dlux_media_csp;
        add_header Content-Disposition $dlux_media_disposition;
    }
    location ^~ /media/dlux/assets/font/ {
        root /app;
        add_header X-Content-Type-Options "nosniff";
        add_header Content-Security-Policy $dlux_media_csp;
        add_header Content-Disposition $dlux_media_disposition;
    }

    # Every other stored file is private: the app decides who gets it before
    # nginx sends it (403 when refused).
    location /media/ {
        if ($cross_site_request) { return 403; }
        auth_request /_dlux_media_access;
        root /app;
        add_header Cache-Control "private, no-cache";
        add_header X-Content-Type-Options "nosniff";
        add_header Content-Security-Policy $dlux_media_csp;
        add_header Content-Disposition $dlux_media_disposition;
    }

    location = /_dlux_media_access {
        internal;
        proxy_pass http://$web_upstream/sys/files/media-access/;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        # Always set here, so a client cannot supply its own.
        proxy_set_header X-Forwarded-Uri $request_uri;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location / {
        if ($cross_site_request) { return 403; }
        if (-f /opt/dlux-runtime/state/maintenance) { return 503; }
        proxy_pass http://$web_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Hybrid health endpoint:
    # - normal operation: proxy to Django's /health/
    # - planned maintenance: proxy-local 200 so a front proxy keeps backend UP
    location /health {
        default_type text/plain;
        if ($cross_site_request) { return 403; }
        if (-f /opt/dlux-runtime/state/maintenance) { return 200 "ok\n"; }
        proxy_pass http://$web_upstream/health/;
        access_log off;
    }
}
