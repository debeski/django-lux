{
  "schema_version": 2,
  "networks": {
    "frontend": {
      "internal": false
    },
    "egress": {
      "internal": false
    },
    "internal": {
      "internal": true
    },
    "docker_proxy": {
      "internal": true
    }
  },
  "services": {
    "db": {
      "networks": [
        "internal"
      ],
      "restart": "protected"
    },
    "redis": {
      "networks": [
        "internal"
      ],
      "restart": "protected"
    },
    "web": {
      "networks": [
        "internal"
      ],
      "restart": "safe",
      "command_module": "dlux.updater.supervisor"
    },
    "celery": {
      "networks": [
        "internal"
      ],
      "restart": "safe",
      "command_module": "dlux.updater.supervisor"
    },
    "smtp-relay": {
      "networks": [
        "egress",
        "internal"
      ],
      "restart": "safe",
      "command_module": "dlux.smtp_relay"
    },
    "dlux-updater": {
      "networks": [
        "egress",
        "internal"
      ],
      "restart": "protected",
      "command_module": "dlux.updater.supervisor"
    },
    "caddy": {
      "networks": [
        "frontend",
        "internal"
      ],
      "publishes_ports": true,
      "restart": "safe"
    },
    "docker-socket-proxy": {
      "networks": [
        "docker_proxy"
      ],
      "restart": "protected"
    },
    "composer-executor": {
      "networks": [
        "docker_proxy"
      ],
      "restart": "protected"
    },
    "composer-agent": {
      "networks": [
        "egress",
        "docker_proxy"
      ],
      "restart": "protected"
    }
  },
  "invariants": {
    "ingress_services": [
      "caddy"
    ],
    "egress_services": [
      "smtp-relay",
      "dlux-updater",
      "composer-agent"
    ],
    "internal_only_services": [
      "db",
      "redis",
      "web",
      "celery"
    ],
    "frontend_egress_disjoint": true,
    "docker_socket": {
      "path": "/var/run/docker.sock",
      "access": {
        "docker-socket-proxy": "ro",
        "composer-executor": "rw"
      },
      "allowed_services": [
        "docker-socket-proxy",
        "composer-executor"
      ]
    },
    "runtime_volume": {
      "volume": "dlux_runtime",
      "read_write_services": [
        "dlux-updater",
        "composer-agent",
        "composer-executor"
      ],
      "read_only_services": [
        "web",
        "celery",
        "caddy"
      ]
    },
    "restart": {
      "label": "org.dlux.restart",
      "safe": [
        "web",
        "celery",
        "smtp-relay",
        "caddy"
      ],
      "protected": [
        "db",
        "redis",
        "dlux-updater",
        "docker-socket-proxy",
        "composer-executor",
        "composer-agent"
      ]
    },
    "retired_command_modules": {
      "tools.smtp_relay": "dlux.smtp_relay",
      "tools.dlux_runtime_supervisor": "dlux.updater.supervisor"
    }
  },
  "removed_services": {
    "db-backup": {
      "since": "1.5.8",
      "reason": "Superseded by DjangoLux system backups (scheduled Celery-beat, pre-update, and on-demand) with in-app restore.",
      "safe_to_remove": true
    },
    "pgadmin": {
      "since": "1.5.8",
      "reason": "Dropped from the default stack; run it ad hoc if needed.",
      "safe_to_remove": true
    }
  },
  "volumes": [
    "postgres_data",
    "redis_data",
    "static",
    "dlux_runtime",
    "composer_agent_state",
    "composer_exec_sock",
    "caddy_data",
    "caddy_config"
  ],
  "env_keys": [
    "DJANGO_SECRET_KEY",
    "WEB_IMAGE",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "ADMIN_PASS",
    "BASE_URL",
    "ALLOWED_URLS",
    "ALLOWED_HOSTS",
    "TIME_ZONE",
    "NGINX_PORT",
    "NGINX_SERVER_NAME",
    "NGINX_MAX_SIZE",
    "CADDY_PORT",
    "CADDY_SITE_ADDRESS",
    "CADDY_MAX_SIZE",
    "DEFAULT_FROM_EMAIL",
    "SMTP_RELAY_HOST",
    "SMTP_RELAY_PORT",
    "SMTP_RELAY_USE_TLS",
    "SMTP_RELAY_USER",
    "SMTP_RELAY_PASSWORD"
  ]
}
