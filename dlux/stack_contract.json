{
  "schema_version": 1,
  "networks": {
    "frontend": {"internal": false},
    "egress": {"internal": false},
    "internal": {"internal": true},
    "docker_proxy": {"internal": true}
  },
  "services": {
    "db": {"networks": ["internal"], "restart": "protected"},
    "redis": {"networks": ["internal"], "restart": "protected"},
    "web": {"networks": ["internal"], "restart": "safe"},
    "celery": {"networks": ["internal"], "restart": "safe"},
    "smtp-relay": {"networks": ["egress", "internal"], "restart": "safe"},
    "dlux-updater": {"networks": ["egress", "internal"], "restart": "protected"},
    "caddy": {"networks": ["frontend", "internal"], "publishes_ports": true, "restart": "safe"},
    "docker-socket-proxy": {"networks": ["docker_proxy"], "restart": "protected"},
    "composer-agent": {"networks": ["egress", "docker_proxy"], "restart": "protected"}
  },
  "invariants": {
    "ingress_services": ["caddy"],
    "egress_services": ["smtp-relay", "dlux-updater", "composer-agent"],
    "internal_only_services": ["db", "redis", "web", "celery"],
    "frontend_egress_disjoint": true,
    "docker_socket": {
      "path": "/var/run/docker.sock",
      "access": "ro",
      "allowed_services": ["docker-socket-proxy"]
    },
    "runtime_volume": {
      "volume": "dlux_runtime",
      "read_write_services": ["dlux-updater", "composer-agent"],
      "read_only_services": ["web", "celery", "caddy"]
    },
    "restart": {
      "label": "org.dlux.restart",
      "safe": ["web", "celery", "smtp-relay", "caddy"],
      "protected": ["db", "redis", "dlux-updater", "docker-socket-proxy", "composer-agent"]
    }
  },
  "removed_services": {
    "db-backup": {
      "since": "1.5.8",
      "reason": "Superseded by DjangoLux system backups (scheduled Celery-beat, pre-update, and on-demand) with in-app restore.",
      "safe_to_remove": true
    },
    "pgadmin": {
      "since": "1.5.8",
      "reason": "Dropped from the default stack; run it ad hoc if needed.",
      "safe_to_remove": true
    }
  },
  "volumes": [
    "postgres_data",
    "redis_data",
    "static",
    "dlux_runtime",
    "composer_agent_state",
    "caddy_data",
    "caddy_config"
  ],
  "env_keys": [
    "DJANGO_SECRET_KEY",
    "WEB_IMAGE",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "ADMIN_PASS",
    "BASE_URL",
    "ALLOWED_URLS",
    "ALLOWED_HOSTS",
    "NGINX_PORT",
    "NGINX_SERVER_NAME",
    "NGINX_MAX_SIZE",
    "CADDY_PORT",
    "CADDY_SITE_ADDRESS",
    "CADDY_MAX_SIZE",
    "DEFAULT_FROM_EMAIL",
    "SMTP_RELAY_HOST",
    "SMTP_RELAY_PORT",
    "SMTP_RELAY_USE_TLS",
    "SMTP_RELAY_USER",
    "SMTP_RELAY_PASSWORD"
  ]
}
