{
  "comment": "Both repositories' field projections must produce these results.",
  "cases": [
    {
      "name": "geocode rows, some without a state",
      "fields": [
        "[].name",
        "[].state",
        "[].lat"
      ],
      "document": [
        {
          "name": "Tripoli",
          "state": "Tripoli District",
          "lat": 32.9,
          "lon": 13.2
        },
        {
          "name": "Tripoli",
          "lat": 34.4
        }
      ],
      "expected": {
        "[].name": [
          "Tripoli",
          "Tripoli"
        ],
        "[].state": [
          "Tripoli District",
          null
        ],
        "[].lat": [
          32.9,
          34.4
        ]
      }
    },
    {
      "name": "nested fields and list index",
      "fields": [
        "main.temp",
        "weather.0.description",
        "weather.1.id",
        "missing.path"
      ],
      "document": {
        "main": {
          "temp": 21.5,
          "extra": {
            "deep": 1
          }
        },
        "weather": [
          {
            "description": "clear sky"
          }
        ]
      },
      "expected": {
        "main.temp": 21.5,
        "weather.0.description": "clear sky",
        "weather.1.id": null,
        "missing.path": null
      }
    },
    {
      "name": "containers are never returned",
      "fields": [
        "a",
        "b",
        "c"
      ],
      "document": {
        "a": {
          "x": 1
        },
        "b": [
          1,
          2
        ],
        "c": true
      },
      "expected": {
        "a": null,
        "b": null,
        "c": true
      }
    },
    {
      "name": "long strings are cut",
      "fields": [
        "s"
      ],
      "document": {
        "s": ""
      },
      "expected": {
        "s": ""
      }
    },
    {
      "name": "star on a non-list is empty",
      "fields": [
        "[].n"
      ],
      "document": {
        "n": 1
      },
      "expected": {
        "[].n": null
      }
    }
  ]
}
