# ----------------------------
# Compression Settings (gzip)
# ----------------------------
gzip on;
gzip_disable "msie6";
gzip_vary on;
gzip_proxied any;
gzip_comp_level 7;
gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};
    client_max_body_size ${NGINX_MAX_SIZE};
    error_page 502 503 504 =503 /dlux-maintenance.html;

    # Re-resolve the app container's IP at request time via Docker's embedded
    # DNS (127.0.0.11). A literal `proxy_pass http://web:8000` resolves once at
    # worker startup and caches that IP; when the composer updater recreates
    # `web` during an image update it comes back on a NEW IP, so nginx keeps
    # hammering the dead address and the app never returns until nginx itself is
    # restarted. Resolving through a variable + resolver makes nginx pick up the
    # new IP on its own (Caddy, the default proxy in this scaffold, does this
    # natively — this directive is the nginx-fallback equivalent).
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    set $web_upstream "web:8000";

    location = /dlux-maintenance.html {
        root /usr/share/nginx/html;
        internal;
    }

    location = /_update/status.json {
        alias /opt/dlux-runtime/state/deploy-status.json;
        default_type application/json;
        add_header Cache-Control "no-store";
        add_header X-Robots-Tag "noindex";
    }

    location = /_update/log.txt {
        alias /opt/dlux-runtime/state/deploy-log.txt;
        default_type text/plain;
        add_header Cache-Control "no-store";
        add_header X-Robots-Tag "noindex";
    }

    # Edge-liveness probe for a front proxy's health check. ALWAYS 200, served
    # entirely by nginx — never proxied to web, never gated by the maintenance
    # flag — so the front proxy keeps this backend marked UP while web is
    # recreated during an image update.
    location = /_edge-alive {
        return 200 "ok\n";
        default_type text/plain;
        access_log off;
    }

    location /static/ {
        alias /app/staticfiles/;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ^~ /media/dlux_backups/ {
        return 404;
    }

    location /media/ {
        alias /app/media/;
    }

    location / {
        if (-f /opt/dlux-runtime/state/maintenance) { return 503; }
        proxy_pass http://$web_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /pgadmin4/ {
        proxy_pass http://pgadmin:80/;
        proxy_set_header X-Script-Name /pgadmin4;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    # Hybrid health endpoint:
    # - normal operation: proxy to Django's /health/
    # - planned maintenance: proxy-local 200 so a front proxy keeps backend UP
    location /health {
        default_type text/plain;
        if (-f /opt/dlux-runtime/state/maintenance) { return 200 "ok\n"; }
        proxy_pass http://$web_upstream/health/;
        access_log off;
    }
}
