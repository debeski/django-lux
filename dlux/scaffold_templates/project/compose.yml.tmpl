name: {{ project_slug }}

x-environment:
  # Database settings
  &de
  WEB_IMAGE: "${WEB_IMAGE:-{{ project_image }}:{{ project_image_tag }}}"
  POSTGRES_DB: "${POSTGRES_DB:-{{ project_slug }}_db}"
  POSTGRES_PORT: "5432"
  POSTGRES_HOST: "db"
  # Redis / Celery
  REDIS_URL_DB: "redis://redis:6379/1"
  CELERY_BROKER_URL: "redis://redis:6379/2"
  CELERY_RESULT_BACKEND: "redis://redis:6379/3"
  # Web app settings (override these in compose.dev.yml or .env)
  ALLOWED_HOSTS: "${ALLOWED_HOSTS:-web,caddy,nginx,localhost,127.0.0.1}"
  ALLOWED_URLS: "${ALLOWED_URLS:-http://localhost:81}"
  BASE_URL: "${BASE_URL:-http://localhost}"
  DEBUG_STATUS: "${DEBUG_STATUS:-False}"
  TIME_ZONE: "${TIME_ZONE:-UTC}"
  # DjangoLux verified inline updater (generated Compose deployments only)
  DLUX_INLINE_UPDATES_ENABLED: "True"
  DLUX_UPDATE_CHECK_INTERVAL: "${DLUX_UPDATE_CHECK_INTERVAL:-86400}"
  DLUX_UPDATE_RUNTIME_ROOT: "/opt/dlux-runtime"
  # App email settings. The app talks to the internal SMTP relay; only the relay has public egress.
  EMAIL_BACKEND: "django.core.mail.backends.smtp.EmailBackend"
  EMAIL_HOST: "smtp-relay"
  EMAIL_PORT: "1025"
  EMAIL_USE_TLS: "False"
  EMAIL_USE_SSL: "False"
  DEFAULT_FROM_EMAIL: "${DEFAULT_FROM_EMAIL:-webmaster@localhost}"

services:
  db:
    image: postgres:17
    restart: always
    labels:
      org.dlux.restart: "protected"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    environment:
      <<: *de
      POSTGRES_USER: ${POSTGRES_USER:-admin}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-admin_pass}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
    networks:
      - internal

  redis:
    image: redis:7
    restart: always
    labels:
      org.dlux.restart: "protected"
    command: ["redis-server", "--appendonly", "yes", "--appendfsync", "everysec", "--maxmemory", "500mb", "--maxmemory-policy", "allkeys-lru"]
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 5
    networks:
      - internal

  smtp-relay:
    image: ${WEB_IMAGE:-{{ project_image }}:{{ project_image_tag }}}
    restart: always
    # org.dlux.restart tells Composer whether it may restart a service during a
    # deploy/recovery, so it classifies from labels instead of a hardcoded name
    # list. "safe" = stateless / owns no in-flight operation; "protected" = holds
    # state, is a data store, or manages its own lifecycle. smtp-relay is a
    # stateless relay: safe.
    labels:
      org.dlux.restart: "safe"
    entrypoint: []
    command: ["python", "-m", "dlux.smtp_relay"]
    environment:
      <<: *de
      POSTGRES_USER: ${POSTGRES_USER:-admin}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-admin_pass}
      DJANGO_SECRET_KEY: ${DJANGO_SECRET_KEY:-local_secret}
      DJANGO_SETTINGS_MODULE: "{{ config_package }}.settings"
      SMTP_RELAY_LISTEN_HOST: "0.0.0.0"
      SMTP_RELAY_LISTEN_PORT: "1025"
      SMTP_RELAY_HOST: "${SMTP_RELAY_HOST:-smtp.gmail.com}"
      SMTP_RELAY_PORT: "${SMTP_RELAY_PORT:-587}"
      SMTP_RELAY_USE_TLS: "${SMTP_RELAY_USE_TLS:-True}"
      SMTP_RELAY_USER: "${SMTP_RELAY_USER:-}"
      SMTP_RELAY_PASSWORD: "${SMTP_RELAY_PASSWORD:-}"
    healthcheck:
      test: ["CMD", "python", "-c", "import socket; socket.create_connection(('127.0.0.1', 1025), 5).close()"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 5s
    networks:
      - egress
      - internal

  # DjangoLux updater start
  dlux-updater:
    image: ${WEB_IMAGE:-{{ project_image }}:{{ project_image_tag }}}
    restart: always
    # Protected: owns durable inline-update state and restarts itself on a
    # generation bump; an external restart mid-update is unsafe.
    labels:
      org.dlux.restart: "protected"
    command: ["python", "-m", "dlux.updater.supervisor", "--no-watch", "--", "bash", "-c", "python manage.py dlux_reconcile; python manage.py migrator && exec python manage.py dlux_update_worker"]
    entrypoint: ["/app/entrypoint.sh"]
    volumes:
      - dlux_runtime:/opt/dlux-runtime:rw
      - static:/app/staticfiles:rw
      - ./media/:/app/media:rw
      - ./logs/:/app/logs:rw
    environment:
      <<: *de
      POSTGRES_USER: ${POSTGRES_USER:-admin}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-admin_pass}
      DJANGO_SECRET_KEY: ${DJANGO_SECRET_KEY:-local_secret}
      ADMIN_PASS: ${ADMIN_PASS:-admin}
    healthcheck:
      test: ["CMD", "python", "-m", "dlux.updater.health"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 60s
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    networks:
      - egress
      - internal
  # DjangoLux updater end

  # ── Reverse proxy ──────────────────────────────────────────────────────────
  # Two interchangeable proxies share ./.proxy/ (Caddyfile + default.conf.template
  # + maintenance.html) and are functionally equivalent. Caddy is active; nginx is
  # kept fully wired but commented out as a drop-in fallback. To switch back:
  # comment out the `caddy:` service below and uncomment the `nginx:` block.
  #
  # Both re-resolve the recreated `web` container and are NOT gated on web health,
  # so the maintenance progress page + /_update/* polling stay served during an
  # image update. Caddy re-resolves natively; the nginx variant uses a `resolver`
  # directive in default.conf.template for the same effect.

  # nginx (fallback — uncomment to use instead of caddy):
  # nginx:
  #   image: nginx:latest
  #   restart: always
  #   labels:
  #     org.dlux.restart: "safe"
  #   ports:
  #     - target: 80
  #       published: "${NGINX_PORT:-80}"
  #       protocol: tcp
  #   environment:
  #     NGINX_SERVER_NAME: ${NGINX_SERVER_NAME:-localhost}
  #     NGINX_MAX_SIZE: ${NGINX_MAX_SIZE:-10M}
  #     # Restrict envsubst to NGINX_*-prefixed vars only, so nginx's own runtime
  #     # variables (host, remote_addr, scheme, ...) survive template rendering.
  #     NGINX_ENVSUBST_FILTER: "NGINX_"
  #   volumes:
  #     - ./.proxy/default.conf.template:/etc/nginx/templates/default.conf.template:ro
  #     - static:/app/staticfiles:ro
  #     - ./media/:/app/media:ro
  #     - dlux_runtime:/opt/dlux-runtime:ro
  #     - ./.proxy/maintenance.html:/usr/share/nginx/html/dlux-maintenance.html:ro
  #   depends_on:
  #     web:
  #       condition: service_started
  #   healthcheck:
  #     test: ["CMD-SHELL", "nginx -t || exit 1"]
  #     interval: 30s
  #     timeout: 10s
  #     retries: 3
  #     start_period: 10s
  #   networks:
  #     - frontend
  #     - internal

  # caddy (active): plain HTTP on :80 with auto_https off (see .proxy/Caddyfile),
  # so the app sits behind your own TLS terminator or is used in local dev. The
  # published host port reads CADDY_PORT, then legacy NGINX_PORT, then 80, so a
  # front proxy pointed at the old nginx host port keeps working after the swap.
  # Point the front proxy's backend health check at GET /_edge-alive or /health.
  caddy:
    image: caddy:latest
    restart: always
    labels:
      org.dlux.restart: "safe"
    ports:
      - target: 80
        published: "${CADDY_PORT:-${NGINX_PORT:-80}}"
        protocol: tcp
    environment:
      CADDY_SITE_ADDRESS: "${CADDY_SITE_ADDRESS:-:80}"
      CADDY_MAX_SIZE: "${CADDY_MAX_SIZE:-10MB}"
    volumes:
      - ./.proxy/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
      - static:/app/staticfiles:ro
      - ./media/:/app/media:ro
      - dlux_runtime:/opt/dlux-runtime:ro
      - ./.proxy/maintenance.html:/usr/share/caddy/maintenance/maintenance.html:ro
    depends_on:
      web:
        condition: service_started
    healthcheck:
      test: ["CMD", "caddy", "validate", "--adapter", "caddyfile", "--config", "/etc/caddy/Caddyfile"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    networks:
      - frontend
      - internal

  web:
    image: ${WEB_IMAGE:-{{ project_image }}:{{ project_image_tag }}}
    restart: always
    labels:
      org.dlux.restart: "safe"
    command: >
      python -m dlux.updater.supervisor -- bash -c ' if [ "$$DEBUG_STATUS" = "True" ]; then
          echo "Starting in DEBUG mode with Django development server..."
          python manage.py runserver 0.0.0.0:8000
      else
          echo "Starting in PRODUCTION mode with Gunicorn..."
          gunicorn -c gunicorn.py {{ config_package }}.wsgi:application
      fi'
    entrypoint: ["/app/entrypoint.sh"]
    post_start:
      # Re-run migrations after the composer updater recreates web onto a new
      # image, so a released image's migrations apply on recreate. Idempotent.
      # Must run under the runtime supervisor (like dlux-updater's migrator), so
      # its collectstatic uses the SAME runtime-active DjangoLux release gunicorn
      # serves templates from. Run raw, it collects from the baked image instead,
      # and — running last on recreate — overwrites the correct static with a
      # version-mismatched set (stale CSS/JS against newer templates).
      - command: python -m dlux.updater.supervisor --no-watch -- python manage.py migrator
    volumes:
      - static:/app/staticfiles:rw
      - ./media/:/app/media:rw
      - ./logs/:/app/logs:rw
      - ./imports/:/app/imports:ro
      - dlux_runtime:/opt/dlux-runtime:ro
    environment:
      <<: *de
      POSTGRES_USER: ${POSTGRES_USER:-admin}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-admin_pass}
      DJANGO_SECRET_KEY: ${DJANGO_SECRET_KEY:-local_secret}
      ADMIN_PASS: ${ADMIN_PASS:-admin}
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/', timeout=5).read()"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      smtp-relay:
        condition: service_healthy
      dlux-updater:
        condition: service_healthy
    networks:
      - internal

  celery:
    image: ${WEB_IMAGE:-{{ project_image }}:{{ project_image_tag }}}
    restart: always
    labels:
      org.dlux.restart: "safe"
    command: ["python", "-m", "dlux.updater.supervisor", "--", "python", "-m", "celery", "-A", "{{ config_package }}", "worker", "-B", "--loglevel=info"]
    entrypoint: ["/app/entrypoint.sh"]
    volumes:
      - static:/app/staticfiles:ro
      - ./media/:/app/media:rw
      - ./logs/:/app/logs:rw
      - dlux_runtime:/opt/dlux-runtime:ro
    environment:
      <<: *de
      POSTGRES_USER: ${POSTGRES_USER:-admin}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-admin_pass}
      DJANGO_SECRET_KEY: ${DJANGO_SECRET_KEY:-local_secret}
      ADMIN_PASS: ${ADMIN_PASS:-admin}
    healthcheck:
      test: ["CMD", "python", "-m", "celery", "-A", "{{ config_package }}", "inspect", "ping"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      dlux-updater:
        condition: service_healthy
    networks:
      - internal

  # DjangoLux Composer agent start
  # Read-only Docker gateway (POST=0, EXEC=0): the agent reads container/image
  # state through it but can never mutate. Writes go through composer-executor.
  docker-socket-proxy:
    image: tecnativa/docker-socket-proxy:latest
    restart: always
    labels:
      org.dlux.restart: "protected"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    environment:
      CONTAINERS: 1
      IMAGES: 1
      EVENTS: 1
      INFO: 1
      PING: 1
      VERSION: 1
      NETWORKS: 0
      VOLUMES: 0
      POST: 0
      EXEC: 0
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - docker_proxy

  # Holds the real Docker socket and performs every write. Not network-facing: it
  # watches the update trigger and serves the agent typed restart/recovery ops.
  composer-executor:
    image: debeski/composer:latest
    restart: unless-stopped
    labels:
      org.dlux.restart: "protected"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    # DAC_READ_SEARCH lets this UID-0-but-uncapped process read the project's
    # own 0600 .secrets/.env to deploy. Read-only override — no write/exec/setuid
    # bypass. Without it, deploys fail reading secrets and inline updates break.
    cap_add:
      - DAC_READ_SEARCH
    working_dir: "${PWD}"
    command:
      - executor
      - --socket
      - /run/composer-exec/composer-exec.sock
      - --trigger-file
      - /opt/dlux-runtime/state/image-update-request.json
      - --status-file
      - /opt/dlux-runtime/state/deploy-status.json
      - --interval
      - "2"
    environment:
      WEB_IMAGE: "${WEB_IMAGE:-{{ project_image }}:{{ project_image_tag }}}"
      COMPOSER_EXECUTOR_SOCKET: "/run/composer-exec/composer-exec.sock"
      COMPOSER_VERSION_LABEL: "org.{{ project_slug }}.dlux_baked_version"
      COMPOSER_RELEASE_MANIFEST_LABEL: "org.dlux.project.release-manifest"
      COMPOSER_ACTIVE_VERSION_FILE: "/opt/dlux-runtime/state/active.json"
      COMPOSER_ACTIVE_VERSION_KEY: "version"
      COMPOSER_STATUS_FILE: "/opt/dlux-runtime/state/deploy-status.json"
      COMPOSER_WATCH_SELF_SERVICE: "composer-executor"
      COMPOSER_EXCLUDE_SERVICES: "composer-agent,composer-executor,docker-socket-proxy,db,redis"
      COMPOSER_AGENT_RESTART_SERVICES: "web,celery,smtp-relay,caddy"
    volumes:
      - "${PWD}:${PWD}:ro"
      - dlux_runtime:/opt/dlux-runtime:rw
      - composer_exec_sock:/run/composer-exec:rw
      - /var/run/docker.sock:/var/run/docker.sock:rw
    networks:
      - docker_proxy

  # Outbound-only control-plane agent. Reads Docker via the proxy, delegates all
  # writes to composer-executor, and relays status. DLUX owns backup/maintenance.
  composer-agent:
    image: debeski/composer:latest
    restart: unless-stopped
    # Protected: manages its own lifecycle (COMPOSER_WATCH_SELF_SERVICE); Composer
    # must never externally restart the agent driving the deploy.
    labels:
      org.dlux.restart: "protected"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    working_dir: "${PWD}"
    command:
      - agent
      - --trigger-file
      - /opt/dlux-runtime/state/image-update-request.json
      - --status-file
      - /opt/dlux-runtime/state/deploy-status.json
      - --bridge-dir
      - /opt/dlux-runtime/state/agent
      - --interval
      - "2"
      - --check-image
      - ${WEB_IMAGE:-{{ project_image }}:{{ project_image_tag }}}
      - --availability-file
      - /opt/dlux-runtime/state/image-available.json
      - --check-interval
      - "3600"
    environment:
      DOCKER_HOST: "tcp://docker-socket-proxy:2375"
      WEB_IMAGE: "${WEB_IMAGE:-{{ project_image }}:{{ project_image_tag }}}"
      COMPOSER_CONTROL_URL: "${COMPOSER_CONTROL_URL:-}"
      COMPOSER_ENROLLMENT_TOKEN: "${COMPOSER_ENROLLMENT_TOKEN:-}"
      COMPOSER_AGENT_STATE_DIR: "/var/lib/composer-agent"
      COMPOSER_VERSION_LABEL: "org.{{ project_slug }}.dlux_baked_version"
      COMPOSER_RELEASE_MANIFEST_LABEL: "org.dlux.project.release-manifest"
      COMPOSER_ACTIVE_VERSION_FILE: "/opt/dlux-runtime/state/active.json"
      COMPOSER_ACTIVE_VERSION_KEY: "version"
      COMPOSER_STATUS_FILE: "/opt/dlux-runtime/state/deploy-status.json"
      COMPOSER_WATCH_SELF_SERVICE: "composer-agent"
      COMPOSER_EXECUTOR_SOCKET: "/run/composer-exec/composer-exec.sock"
      COMPOSER_EXCLUDE_SERVICES: "composer-agent,composer-executor,docker-socket-proxy,db,redis"
      COMPOSER_AGENT_RESTART_SERVICES: "web,celery,smtp-relay,caddy"
    volumes:
      - "${PWD}:${PWD}:ro"
      - dlux_runtime:/opt/dlux-runtime:rw
      - composer_agent_state:/var/lib/composer-agent:rw
      - composer_exec_sock:/run/composer-exec:rw
    depends_on:
      docker-socket-proxy:
        condition: service_started
      composer-executor:
        condition: service_started
    networks:
      - egress
      - docker_proxy
  # DjangoLux Composer agent end

volumes:
  postgres_data:
  redis_data:
  static:
  dlux_runtime:
  composer_agent_state:
  # Private socket: the agent's typed write channel to composer-executor.
  composer_exec_sock:
  caddy_data:
  caddy_config:

networks:
  # Published ingress only (caddy). Bridge so the host can reach the app and
  # Caddy can reach Let's Encrypt (ACME) when automatic HTTPS is turned on.
  frontend:
    driver: bridge
  # Outbound internet for the narrow set of services that need it: smtp-relay
  # (→ your SMTP provider), dlux-updater (→ PyPI), composer-agent (→ registry).
  # Separate from `frontend` so the internet-facing proxy shares no network with
  # them; nothing may sit on both.
  egress:
    driver: bridge
  # Inter-service traffic with NO internet access — db, redis, web, celery, …
  internal:
    internal: true
  # Isolated, internet-less path for the Docker-control services: the agent's
  # read-only route to docker-socket-proxy, plus composer-executor (off egress).
  docker_proxy:
    internal: true
