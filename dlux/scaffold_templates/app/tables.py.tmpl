from django.urls import reverse

from dlux.tables import DluxTable
from .models import ExampleRecord


class ExampleRecordTable(DluxTable):
    class Meta(DluxTable.Meta):
        model = ExampleRecord
        fields = ("name", "is_active", "created_at")
        dlux_actions = True  # Enable context menu actions.

    def get_dlux_row_actions(self, record, base_actions):
        """
        Demonstrate Dlux dynamic modal integration for generated apps.

        The direct modal-manager URL shape is:
        /sys/modals/manager/<app_label>/<ModelName>/<pk>/
        """
        display_name = self.get_dlux_record_name(record)
        app_label = record._meta.app_label
        model_name = record._meta.object_name

        return [
            {
                "label": "view_label",
                "icon": "bi bi-eye",
                "type": "event",
                "event": "micro:dynamic_modal:open",
                "data": {
                    "url": reverse("modal_manager", args=[app_label, model_name, record.pk]) + "?action=view",
                    "title": f"View {display_name}",
                },
                "dblclick": True,
            },
            {"type": "divider"},
            {
                "label": "edit_label",
                "icon": "bi bi-pencil",
                "type": "event",
                "event": "micro:dynamic_modal:open",
                "data": {
                    "url": reverse("modal_manager", args=[app_label, model_name, record.pk]),
                    "title": f"Edit {display_name}",
                },
                "permissions": [f"{app_label}.change_{record._meta.model_name}"],
            },
        ]
